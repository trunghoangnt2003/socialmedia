@using Newtonsoft.Json
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Create Group";
    var userJson = Context.Session.GetString("UserFull");
    User user = new User { Name = "Unknown" };

    if (!string.IsNullOrEmpty(userJson))
    {
        try
        {
            user = JsonConvert.DeserializeObject<User>(userJson);
        }
        catch (JsonException ex)
        {
            Console.WriteLine($"Error deserializing user: {ex.Message}");
        }
    }
}


<div class="container mt-5">
    <div class="row">
        <div class="col-md-3">
            <div class="bg-light p-4 rounded shadow">
                <div class="d-flex align-items-center mb-3">
                    <img class="rounded-circle me-3" src="@user.Avatar" alt="Admin Avatar" width="50" height="50" />
                    <div>
                        <h6 class="mb-0">@user.Name <i class="fa-solid fa-user-shield text-primary"></i></h6>
                        <small class="text-muted">Admin</small>
                    </div>
                </div>

                <form method="post" action="Create" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="groupName" class="form-label">
                            <i class="fa-solid fa-users"></i> Group Name:
                        </label>
                        <input id="groupName" name="GroupName" class="form-control" required />
                    </div>

                    @* <div class="mb-3">
                        <label for="groupPrivacy" class="form-label">
                            <i class="fa-solid fa-earth-americas"></i> Choose Privacy:
                        </label>
                        <select id="groupPrivacy" name="GroupPrivacy" class="form-select">
                            <option value="public" selected>🌍 Public - Anyone can join</option>
                            <option value="private">🔒 Private - Invite only</option>
                        </select>
                    </div> *@


                    <div class="mb-3">
                        <label for="avatarUpload" class="form-label">
                            <i class="fa-solid fa-cloud-arrow-up"></i> Avatar:
                        </label>
                        <input type="file" id="avatarUpload" name="Avatar" class="form-control" accept="image/*" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Create
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-9" id="desktopView">
            <div class="bg-light p-4 rounded shadow">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="text-start mb-4">Desktop Preview</h4>
                    </div>
                    <div>
                        <button id="toggleDesktop" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-desktop"></i></button>
                        <button id="toggleMobile" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-mobile-screen"></i></button>
                    </div>
                </div>
                <div id="desktopView">
                    <div id="groupPreview">
                        <p id="groupNamePreview" class="fs-5 fw-bold"></p>
                        <img id="avatarPreview" src="#" alt="Avatar Preview" class="img-fluid rounded" style="display: none;" />
                    </div>
                    <p class="text-muted mt-4"><i class="fas fa-users"></i> Nhóm Công khai · 1 thành viên</p>
                    <hr />
                    <div class="d-flex justify-content-around mb-3">
                        <a href="#" class="text-decoration-none text-dark">
                            <i class="fa-solid fa-circle-info me-1"></i>About
                        </a>
                        <a href="#" class="text-decoration-none text-dark">
                            <i class="fa-solid fa-edit me-1"></i>Post
                        </a>
                        <a href="#" class="text-decoration-none text-dark">
                            <i class="fa-solid fa-user-group me-1"></i>Members
                        </a>
                        <a href="#" class="text-decoration-none text-dark">
                            <i class="fa-solid fa-calendar-days me-1"></i>Events
                        </a>
                        <a href="#" class="text-decoration-none text-dark">
                            <i class="fa-solid fa-image me-1"></i>Image
                        </a>
                        <a href="#" class="text-decoration-none text-dark">
                            <i class="fa-solid fa-photo-film me-1"></i>Video
                        </a>
                    </div>
                </div>

                @* <div id="privacyPreview" class="mt-3">
                    <p class="fs-5 fw-bold">Privacy: 🌍 Public - Anyone can join</p>
                    <p>1 member</p>
                </div> *@
                

                <hr />

                <div class="bg-white p-4 rounded shadow-sm d-flex">
                    <div class="col-sm-8">
                        <div class="bg-white p-4 rounded shadow-sm mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <img src="@user?.Avatar" class="rounded-circle me-2" alt="User profile picture" width="40" height="40">
                                <input type="text" class="form-control rounded-pill" placeholder="Bạn viết gì đi..." readonly onclick="loadAndShowModal()">
                            </div>
                            <div class="d-flex justify-content-between border-top">
                                <button class="btn text-danger"><i class="fas fa-video me-1"></i> Thước phim</button>
                                <button class="btn text-success"><i class="fas fa-image me-1"></i> Ảnh/video</button>
                                <button class="btn text-warning"><i class="fas fa-poll me-1"></i> Thăm dò ý kiến</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3 m-3">
                        <h5 class="font-weight-bold">Giới thiệu</h5>
                        <div class="mt-2">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-globe text-muted me-2"></i>
                                <span>Công khai</span>
                            </div>
                            <p class="text-muted">Bất kỳ ai cũng có thể nhìn thấy mọi người trong nhóm và những gì họ đăng.</p>
                        </div>
                        <div class="mt-2">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-eye text-muted me-2"></i>
                                <span>Hiển thị</span>
                            </div>
                            <p class="text-muted">Ai cũng có thể tìm thấy nhóm này.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="mobileView" class="bg-white p-3 rounded mb-4" style="display: none; max-width: 320px; margin: 0 auto;">
            <h5 id="groupNamePreviewMobile" class="fs-5 fw-bold text-center"></h5>
            <img id="avatarPreviewMobile" src="#" alt="Avatar Preview" class="img-fluid rounded mb-2" style="display: none;" />
            <p class="text-muted mt-2 text-center"><i class="fas fa-users"></i> Nhóm Công khai · 1 thành viên</p>

            <hr />

            <div class="bg-light p-3 rounded shadow-sm mb-3">
                <h6 class="mb-2"><i class="fas fa-circle-info me-1"></i> About</h6>
                <p class="small text-muted">Bất kỳ ai cũng có thể nhìn thấy mọi người trong nhóm và những gì họ đăng.</p>
            </div>

            <div class="bg-light p-3 rounded shadow-sm mb-3">
                <h6 class="mb-2"><i class="fas fa-eye me-1"></i> Visibility</h6>
                <p class="small text-muted">Ai cũng có thể tìm thấy nhóm này.</p>
            </div>

            <div class="d-flex justify-content-around">
                <button class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-edit me-1"></i> Viết bài</button>
                <button class="btn btn-outline-success btn-sm"><i class="fa-solid fa-image me-1"></i> Thêm ảnh</button>
                <button class="btn btn-outline-warning btn-sm"><i class="fa-solid fa-video me-1"></i> Tạo video</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('groupName').addEventListener('input', function () {
        document.getElementById('groupNamePreview').textContent = this.value;
        document.getElementById('groupNamePreviewMobile').textContent = this.value;
    });

    document.getElementById('avatarUpload').addEventListener('change', function () {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (event) {
                document.getElementById('avatarPreview').src = event.target.result;
                document.getElementById('avatarPreview').style.display = 'block';

                document.getElementById('avatarPreviewMobile').src = event.target.result;
                document.getElementById('avatarPreviewMobile').style.display = 'block';
            };
            reader.readAsDataURL(file);
        }
    });

    document.getElementById('groupPrivacy').addEventListener('change', function () {
        const selectedOption = this.options[this.selectedIndex].text;
        document.getElementById('privacyPreview').innerHTML = `<p class="fs-5 fw-bold">Privacy: ${selectedOption}</p> <p>1 member</p>`;
    });

    document.getElementById('toggleDesktop').addEventListener('click', function () {
        document.getElementById('desktopView').style.display = 'block';
        document.getElementById('mobileView').style.display = 'none';
    });

    document.getElementById('toggleMobile').addEventListener('click', function () {
        document.getElementById('desktopView').style.display = 'none';
        document.getElementById('mobileView').style.display = 'block';
    });

</script>
