@{
    ViewData["Title"] = "Home Page";
}

<style>
    .user-item{
    cursor: pointer
    }

    .user-item:hover {
    background-color: lightgray;
    }

    .status {
    width: 10px;
    height: 10px;
    background-color: green;
    border-radius: 50%;
    margin-left: 5px;
    }

    .input-container {
    background-color: #f0f2f5;
    border-radius: 8px;
    padding: 10px 20px;
    }

    .input-container2 {
    background-color: #EEEEEE;
    border-radius: 50px;
    padding: 10px 20px;
    }

    .input-container input {
    background-color: #f0f2f5;
    border: none;
    color: #050505;
    outline: none;
    }

    .btn-custom {
    background-color: #e4e6eb;
    color: #050505;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    }

    .btn-custom i {
    margin-right: 5px;
    }

    .btn-custom span {
    color: #050505;
    }

    .btn-custom-red {
    color: #f02849;
    }

    .btn-custom-green {
    color: #45bd62;
    }

    .btn-custom-yellow {
    color: #f7b928;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: auto; /* Cuộn toàn trang */
    }

    .col-md-8 {
        height: 100vh; /* Chiều cao full màn hình */
        overflow-y: auto; /* Thanh cuộn dọc */
        padding-right: 10px; /* Tránh đè vào thanh cuộn */
        scroll-behavior: smooth; /* Cuộn mượt */
    }
</style>

<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <div class="container d-flex justify-content-center align-items-start">
            <div class="w-100">
                <div class="d-flex align-items-start mb-3 input-container" >
                    <img src="@ViewBag.User.Avatar" class="rounded-circle" width="40" height="40" alt="User profile picture">
                    <div class="ms-2 text-black-50 input-container2 w-100" style="cursor:pointer" data-bs-toggle="modal"
                    data-bs-target="#createModal">@ViewBag.User.Name ơi, bạn đang nghĩ gì thế?</div>
                </div>
            </div>
        </div>
        <div id="postContainer">
            @foreach (Post post in ViewBag.Posts)
            {
                @await Html.PartialAsync("Home/_ViewPost", post)
            }
        </div>
        <div id="loading" class="text-center mt-3" style="display: none;">
            <span>Đang tải thêm bài viết...</span>
        </div>

    </div>
    <div class="col-md-2">
        <h2>Danh sách bạn bè</h2>
        @foreach (var friend in ViewBag.Friends)
        {
            <div class="user-item d-flex align-items-center p-2 rounded-3" onclick="OpenChat(@friend.Friend1Navigation.Id  )">
                <div class="position-relative me-3">
                    <img src="@friend.Friend1Navigation.Avatar"
                    alt="Avatar of @friend.Friend1Navigation.Name" 
                    class="rounded-circle" 
                    width="30" height="30"> 
                    <div class="status rounded-circle border border-white border-2 position-absolute bottom-0 end-0 "></div>
                </div>
                <span>@friend.Friend1Navigation.Name</span>
            </div>
        }
    </div>
</div>

<div id="modal">

</div>
