                            <img src="https://storage.googleapis.com/a1aa/image/vFQW6tc3TP_8xpHGXg-IREVyYMBRvUVuh3-Lp-d9zmc.jpg" alt="Chợ Võ Case Máy Tính" class="rounded-circle mr-2" width="32" height="32">
                            <span class="ps-1">Chợ Võ Case Máy Tính</span>
                        </li>
                        <li class="d-flex align-items-center mb-2">
                            <img src="https://storage.googleapis.com/a1aa/image/YHxMWSQ1XpSRqcdjNP_GWFw09V-L_XWD08llV_M506Y.jpg" alt="CHỢ PC CŨ THANH LÝ" class="rounded-circle mr-2" width="32" height="32">
                            <span class="ps-1">CHỢ PC CŨ THANH LÝ</span>
                        </li>
                        <li class="d-flex align-items-center mb-2">
                            <img src="https://storage.googleapis.com/a1aa/image/c-zgzYm9kgAou1YUgmgp_fEwuVmtThFHKYLwG2aIf_s.jpg" alt="GEARVN - Chợ PC &amp; Gaming Gear" class="rounded-circle mr-2" width="32" height="32">
                            <span class="ps-1">GEARVN - Chợ PC &amp; Gaming Gear</span>
                        </li>
                        <li class="d-flex align-items-center mb-2">
                            <img src="https://storage.googleapis.com/a1aa/image/8CLZhArYGqVSxxlUaPlkLPyUUfjBL4hPGqw2ShspzZc.jpg" alt="REMOTE, Freelancer IT Vietnam" class="rounded-circle mr-2" width="32" height="32">
                            <span class="ps-1">REMOTE, Freelancer IT Vietnam</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 colCustome">
        <div class="container d-flex justify-content-center align-items-start"> 
            <div class="w-100"> 
                 <div class="d-flex align-items-start mb-3 input-container" > 
                     <img src="@ViewBag.User.Avatar" class="rounded-circle" width="40" height="40" alt="User profile picture"> 
                     <div class="ms-2 text-black-50 input-container2 w-100" style="cursor:pointer" data-bs-toggle="modal" 
                     data-bs-target="#createModal">@ViewBag.User.Name ơi, bạn đang nghĩ gì thế?</div> 
                 </div> 
             </div> 
         </div> 
         <div id="postContainer" class="pb-5">
             @foreach (Post post in ViewBag.Posts) 
             {
                 @await Html.PartialAsync("Home/_ViewPost", post)
             } 
         </div> 
         <div id="loading" class="text-center mt-3" style="display: none;"> 
            <span>Đang tải thêm bài viết...</span>
         </div>

    </div>
    <div class="col-md-3">
        <h2>Danh sách bạn bè</h2>
        @foreach (var friend in ViewBag.Friends)
        {
            <div class="user-item d-flex align-items-center p-2 rounded-3" onclick="OpenChat(@friend.Friend1Navigation.Id  )">
                <div class="position-relative me-3">
                    <img src="@friend.Friend1Navigation.Avatar"
                    alt="Avatar of @friend.Friend1Navigation.Name" 
                    class="rounded-circle" 
                    width="30" height="30"> 
                    <div class="status rounded-circle border border-white border-2 position-absolute bottom-0 end-0 "></div>
                </div>
                <span>@friend.Friend1Navigation.Name</span>
            </div>
        }
    </div>
</div>

<div id="modal"> 

</div>
