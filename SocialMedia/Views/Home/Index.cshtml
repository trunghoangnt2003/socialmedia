@{
    ViewData["Title"] = "Home Page";
}
@using Newtonsoft.Json
@{
    var userJson = Context.Session.GetString("UserFull");
    User user = new User { Name = "Unknown" };

    if (!string.IsNullOrEmpty(userJson))
    {
        try
        {
            user = JsonConvert.DeserializeObject<User>(userJson);
        }
        catch (JsonException ex)
        {
            Console.WriteLine($"Error deserializing user: {ex.Message}");
        }
    }
}
<style>
    .user-item{
    cursor: pointer
    }

    .user-item:hover {
    background-color: lightgray;
    }

    .status { 
     width: 10px; 
     height: 10px; 
     background-color: green; 
     border-radius: 50%; 
     margin-left: 5px; 
    }

    .input-container {
    background-color: #f0f2f5;
    border-radius: 8px;
    padding: 10px 20px;
    }

    .input-container2 {
    background-color: #EEEEEE;
    border-radius: 50px;
    padding: 10px 20px;
    }

    .input-container input {
    background-color: #f0f2f5;
    border: none;
    color: #050505;
    outline: none;
    }

    .btn-custom {
    background-color: #e4e6eb;
    color: #050505;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    }

    .btn-custom i {
    margin-right: 5px;
    }

    .btn-custom span {
    color: #050505;
    }

    .btn-custom-red {
    color: #f02849;
    }

    .btn-custom-green {
    color: #45bd62;
    }

    .btn-custom-yellow {
    color: #f7b928;
    }

    .colCustome {
        height: 100vh; /* Chiều cao full màn hình */
        overflow-y: auto; /* Thanh cuộn dọc */
        padding-right: 10px; /* Tránh đè vào thanh cuộn */
        scroll-behavior: smooth; /* Cuộn mượt */
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden; /* Cuộn toàn trang */
    }
</style>

