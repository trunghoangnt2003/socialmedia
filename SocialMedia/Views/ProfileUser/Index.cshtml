            <!-- Ô đăng bài -->
            <div class="card p-3 mb-3">
                <div class="d-flex align-items-center">
                    <img src="https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg" class="rounded-circle me-2" width="40" height="40">
