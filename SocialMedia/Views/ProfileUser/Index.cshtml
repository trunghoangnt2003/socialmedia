@{
    ViewData["Title"] = "Profile";
    var user = Context.Session.GetString("User");
}

<head>
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>

<div class="profile-container mb-3  ">
    <div class="profile-header ">
        <div class="profile-avatar">
            <img src="@(ViewBag.user?.Avatar ?? "https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg")" 
                 class="profile-picture" alt="Profile Picture">
            <label for="avatarUpload" class="camera-icon">
                <i class="fa fa-camera"></i>
            </label>
            <input type="file" id="avatarUpload" accept="image/*" style="display: none;" onchange="uploadAvatar(event)">
        </div>

        <div class="profile-info">
            <h2>@ViewBag.user?.Name</h2>
            <p><strong>@(ViewBag.Friends.Count)</strong> bạn bè</p>
        </div>
        <div class="profile-actions">
            @if (user != null && user.Equals(ViewBag.user.Id.ToString()))
            {
                        <button  data-bs-toggle="modal"  data-bs-target="#updateModal"  class="edit-btn">Chỉnh sửa trang cá nhân</button>
            }
            else
            {
                <button class="btn btn-secondary">Bạn bè</button>
            <button class="btn btn-primary">Nhắn tin</button>
            }
</div>
        <button class="tab-more"><i class="fa fa-ellipsis-h"></i></button>
    </div>
  </div>
   <div class="profile-tabs">
    <a href="#" class="tab active" data-tab="posts">Bài viết</a>
    <a href="#" class="tab" data-tab="friends">Bạn bè</a>
    <a href="#" class="tab" data-tab="photos">Ảnh</a>
    <a href="#" class="tab" data-tab="videos">Video</a>
</div>

<div id="profile-content">
    <div class="tab-content active" id="posts">
        <div class="profile-introduce">
    <div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card profile-intro p-3 shadow-sm bg-white rounded">
                <h3>Giới thiệu</h3>
                <ul class="list-unstyled">
                   <li><i class="fa-solid fa-cake-candles"></i> <span>&nbsp;@ViewBag.user?.Dob</span></li>
                    <li><i class="fa-solid fa-house"></i><span>&nbsp;@ViewBag.user?.Address</span></li>

                </ul>
            </div>
       <div class="card p-3 mt-3">
        <h4>Tin Nổi Bật</h4>
        <div class="highlighted-stories-container">
            <div class="highlighted-stories">
                <div class="story-item">
                    <img src="https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg" class="rounded" alt="Story 1">
                </div>
                <div class="story-item">
                    <img src="https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg" class="rounded" alt="Story 2">
                </div>
                <div class="story-item">
                    <img src="https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg" class="rounded" alt="Story 3">
                </div>
                <div class="story-item">
                    <img src="https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg" class="rounded" alt="Story 4">
                </div>
                <div class="story-item">
                    <img src="https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg" class="rounded" alt="Story 5">
                </div>
            </div>
        </div>
    </div>

     <div class="card p-3 mt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="mb-0">Bạn bè</h4>
            <a href="#" class="text-primary">Xem tất cả bạn bè</a>
        </div>
        <p class="text-muted">@(ViewBag.Friends.Count) người bạn</p>
        <div class="friend-list">
