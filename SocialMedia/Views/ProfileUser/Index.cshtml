@{
    ViewData["Title"] = "Profile";
    var user = Context.Session.GetString("User");
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true">

<div class="profile-container mb-3" style="display: flex;justify-content: center;" >
    <div class="profile-header" style="width: 90%;">
        <div class="profile-avatar">
            <img src="@(ViewBag.user?.Avatar ?? "https://res.cloudinary.com/ddg2gdfee/image/upload/v1738900139/avatar_male_default_yjf1du.jpg")" 
                 class="profile-picture" alt="Profile Picture">
             @if (user != null && user.Equals(ViewBag.user.Id.ToString()))
            {
                <label for="avatarUpload" class="camera-icon d-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#updateAvatarModal">
                    <i class="fa fa-camera"></i>
            </label>
            }
        </div>

        <div class="profile-info">
            <h2>@ViewBag.user?.Name</h2>
            <p><strong>@(ViewBag.Friends.Count)</strong> bạn bè</p>
        </div>
        <div class="profile-actions">
            @if (user != null && user.Equals(ViewBag.user.Id.ToString()))
            {
                <button  data-bs-toggle="modal"  data-bs-target="#updateModal"  class="edit-btn">Chỉnh sửa trang cá nhân</button>
            }
            else
            {
                if (ViewData["isFriend"] == "Friend")
                {
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="friendDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-user-check"></i> Bạn bè
                        </button>

                        <ul class="dropdown-menu" aria-labelledby="friendDropdown">
                            <li><button class="dropdown-item text-danger" onclick="UnFriend(@ViewBag.user.Id)"><i class="fa-solid fa-user-xmark"></i> Hủy bạn bè</button></li>
                        </ul>
                    </div>
                }
                else if (ViewData["isFriend"] == "None")
                {
                    <div class="dropdown">
                        @* <form asp-action="AddFriend" asp-controller="ProfileUser" method="post" class="d-inline"> *@
                        @*     <input type="hidden" name="id" value="@ViewBag.user.Id" /> *@
                            <button class="btn btn-secondary" type="submit" onclick="AddFriend(@ViewBag.user.Id)" id="addFriend" aria-expanded="false">
                                <i class="fa-solid fa-user-plus"></i> Thêm Bạn bè
                            </button>
                        @* </form> *@
                    </div>
                }
                else if (ViewData["isFriend"] == "Send")
                {
                    <div class="dropdown">
                        <button class="btn btn-secondary" onclick="CancelSend(@ViewBag.user.Id)">
                            <i class="fa-solid fa-user-check"></i> Đã Gủi Lời Mời
                        </button>
                    </div>
                }
                else if (ViewData["isFriend"] == "Request")
                {
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="friendDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-user-check"></i> Yêu Cầu Kết Bạn
                        </button>

                        <ul class="dropdown-menu" aria-labelledby="friendDropdown">
                            <li><button class="dropdown-item text-success" onclick="AcceptRequest(@ViewBag.user.Id)"><i class="fa-solid fa-user-xmark"></i>Chấp Nhận</button></li>
                            <li><button class="dropdown-item text-danger" onclick="CancelRequest(@ViewBag.user.Id)"><i class="fa-solid fa-user-xmark"></i> Hủy</button></li>
                        </ul>
                    </div>
                }

            <button class="btn btn-primary">Nhắn tin</button>
            }
</div>
        <button class="tab-more"><i class="fa fa-ellipsis-h"></i></button>
    </div>
  </div>
   <div style="display: flex;justify-content: center;">
       <div class="profile-tabs" style="width: 90%">
    <a href="#" class="tab active" data-tab="posts">Bài viết</a>
    <a href="#" class="tab" data-tab="friends">Bạn bè</a>
    <a href="#" class="tab" data-tab="photos">Ảnh</a>
    <a href="#" class="tab" data-tab="videos">Video</a>
</div>
   </div>

