        </div>
    </div>
</div>

    </div>
</div>
    </div>
    <div class="tab-content" id="friends">
    <div class="friends-box">
        <div class="friends">
            <h3>Bạn bè</h3>
        <div class="friends-header">
            <div class="search-box">
            <i class="fa fa-search"></i>
