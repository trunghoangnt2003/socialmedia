@model SocialMedia.Models.Post
@using Microsoft.AspNetCore.Html
<style>
    .image-grid {
    display: grid;
    gap: 8px;
    justify-content: center;
    align-items: center;
    }

    .single-media {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    }

    .two-media {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    }

    .three-media {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 8px;
    }

    .three-media .right-grid {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    gap: 8px;
    }

    .media-item {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: auto;
    }

    .media-item img, .media-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    }

    .media-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 8px;
    }
</style>

<div class="w-100 mx-auto mt-10 bg-white rounded-lg shadow-md">
    <div class="flex items-center p-4">
        <img alt="User profile picture" class="w-10 h-10 rounded-full" height="40" src="@Model?.AuthorNavigation?.Avatar" width="40" />
        <div class="ml-3">
            <p class="font-semibold">@Model?.AuthorNavigation?.Name</p>
            @{
                var modifyTime = Model?.ModifyTime;
                if (modifyTime != null)
                {
                    var timeDifference = DateTime.Now - modifyTime.Value;
                    <p class="text-sm text-gray-500">
                        @(timeDifference.TotalMinutes < 1 ? "Vừa xong" : timeDifference.TotalHours < 12 ? (timeDifference.TotalMinutes < 60 ? $"{(int)timeDifference.TotalMinutes} phút trước" : $"{(int)timeDifference.TotalHours} giờ trước") : modifyTime.Value.ToString("dd/MM/yyyy HH:mm"))
                    </p>
                }
                else
                {
                    <p class="text-sm text-gray-500">Không có thời gian chỉnh sửa</p>
                }
            }
        </div>
    </div>

    <div class="px-4 pb-4">
        <p class="mb-4">@Model?.Contents</p>
        <div class="image-grid-container">
            @if (Model?.Resources != null && Model.Resources.Any())
            {
                var resources = Model.Resources.ToList();
                var count = resources.Count;

                if (count == 1)
                {
                    <div class="single-media">
                        @RenderMedia(resources[0])
                    </div>
                }
                else if (count == 2)
                {
                    <div class="two-media">
                        @foreach (var resource in resources)
                        {
                            <div class="media-item">
                                @RenderMedia(resource)
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="three-media">
                        <div class="media-item">
                            @RenderMedia(resources[0])
                        </div>
                        <div class="right-grid">
                            <div class="media-item">
                                @RenderMedia(resources[1])
                            </div>
                            <div class="media-item">
                                @if (count > 3)
                                {
                                    <div class="media-overlay">
                                        +@(count - 3)
                                    </div>
                                }
                                @RenderMedia(resources[2])
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>


        <p class="ps-3 pb-2 text-blue-600">
        <i class="far fa-thumbs-up"></i> <span id="likeCount-@Model.Id">@Model.Reactions.Count</span>
        </p>
        

    </p>
    <div class="flex justify-between items-center px-4 py-2 border-t border-gray-200">
        <div class="flex items-center space-x-2">
            @if (Model.Reactions.Any(r => r.User == ViewBag.User.Id) == true)
            {
                <button id="likeButton-@Model.Id" class="likeButton flex items-center space-x-1 text-blue-600">
                    <i class="far fa-thumbs-up"></i>
                    <span id="likeText-@Model.Id">Đã Thích</span>
                </button>
            }else
            {
                <button id="likeButton-@Model.Id" class="likeButton flex items-center space-x-1 text-gray-500 hover:text-blue-600">
                    <i class="far fa-thumbs-up"></i>
                    <span id="likeText-@Model.Id">Thích</span>
                </button>
            }
            
            
            <a asp-controller="Post" asp-action="PostDetail" asp-route-id="@Model.Id" class="flex items-center space-x-1 text-gray-500 hover:text-blue-600">
                <i class="far fa-comment">
                </i>
                <span>
                    Bình luận
                </span>
            </a>
        </div>
        <button class="text-gray-500 hover:text-blue-600">
            <i class="fas fa-share">
            </i>
            <span>
                Chia sẻ
            </span>
        </button>
    </div>
</div>
@functions {
    public IHtmlContent RenderMedia(Resource resource)
    {
        return resource.Type == (int?)Types.IMAGE
            ? Html.Raw($"<img src='{resource.Url}' alt='Post image' />")
            : Html.Raw($"<video controls><source src='{resource.Url}' type='video/mp4'>Trình duyệt của bạn không hỗ trợ video.</video>");
    } 

   
}
<script>
        document.getElementById('likeButton-'+@Model.Id).addEventListener('click', async () => {
        const likeButton = document.getElementById('likeButton-'+@Model.Id);
        const likeText = document.getElementById('likeText-'+@Model.Id);
        const isLiked = likeText.innerText === 'Thích';
        const likeCount = document.getElementById('likeCount-'+@Model.Id);
        try {
            const response = await fetch('/Post/ToggleLike' , {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ postId: @Model.Id, like: isLiked }),
            });

            if (response.ok) {
                const result = await response.json();
                likeText.innerText = result.liked ? 'Đã thích' : 'Thích';
                likeButton.classList.toggle('text-blue-600', result.liked);
                likeButton.classList.toggle('text-gray-500', !result.liked);
                likeCount.innerText = result.likeCount;
            } else {
                alert('Có lỗi xảy ra khi gửi like!');
            }
        } catch (error) {
            console.error('Lỗi:', error);
        }
    });
     
</script>