@using Newtonsoft.Json
@{
    var userJson = Context.Session.GetString("UserFull");
    User user = new User { Name = "Unknown" };

    if (!string.IsNullOrEmpty(userJson))
    {
        try
        {
            user = JsonConvert.DeserializeObject<User>(userJson);
        }
        catch (JsonException ex)
        {
            Console.WriteLine($"Error deserializing user: {ex.Message}");
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialMedia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialMedia.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/header-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat-modal.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="relative  p-2 navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="row">
                <div class="col-6 d-flex">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SocialMedia</a>
                    <div class="search-wrapper position-relative">
                        <div class="search-box">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" class="form-control search-input" placeholder="Search users or groups...">
                        </div>
                        <ul class="search-results list-group position-absolute w-100 d-none"></ul>
                    </div>
                </div>
              
                <div class="navbar-collapse collapse d-sm-inline-flex  col-6">
                    <ul class="navbar-nav flex-grow-1 justify-content-end">
                        <li class="header-icon nav-item me-2 icon" id="messenger">
                            <div class="position-relative">
                                <div class="header-icon-child rounded-circle bg-primary nav-link">
                                    <i class="fa-brands fa-facebook-messenger fa-xl" style="color: #ffffff;"></i>
                                </div>
                                <div id="unreadCount" class="position-absolute rounded-circle rounded-2 bg-danger text-white text-center d-none ">
                                    0
                                </div>
                            </div>
                            <div class="popup-messenger" id="popupMess">
                                <div class="element-mess">
                                    <i class="fa-solid fa-user text-primary me-2"></i> @(user.Name) Message
                                </div>
                            </div>
                        </li>
                        <li class="header-icon nav-item me-2 icon" id="notification">
                            <div class="header-icon-child icon rounded-circle bg-primary nav-link text-center">
                                <i class="fa-solid fa-bell fa-xl" style="color: #ffffff;"></i>
                            </div>
                            <div class="popup-notification" id="popupNoti">
                                <div class="element-noti">
                                    <i class="fa-solid fa-user text-primary me-2"></i> @(user.Name) notifi
                                </div>
                            </div>
                        </li>
                        <li class="header-icon position-relative nav-item me-4 icon"  id="avatar">
                            <img src="@(user.Avatar)"
                                 alt="Avatar of user"
                                 class="rounded-circle "
                                 width="40" height="40">
                            <div class="user-icon rounded-circle border border-white border-2 position-absolute bottom-0 end-0 d-flex align-items-center justify-content-center ">
                                <i class="fa-solid fa-angle-down fa-2xs text-white" ></i>
                            </div>
                            <div class="popup-menu" id="popupMenu">
                                <div class="element-menu">
                                    <i class="fa-solid fa-user text-primary me-2"></i> @(user.Name)
                                </div>
                                <div class="element-menu">
                                    <i class="fa-solid fa-right-from-bracket text-secondary me-2"></i> Logout
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <div id="chat-modal" class="chat-modal position-fixed"></div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/chat-modal.js" asp-append-version="true"></script>
    <script src="~/js/header.js" asp-append-version="true"></script>
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        "use strict";

        var connection = new signalR.HubConnectionBuilder().withUrl("/signalRService").build();
        connection.start().then(function () {

            console.log("currentUser "+ currentUser + "id " + connection.connectionId);
        });
        var currentUser = @Context.Session.GetString("User");

        connection.on("SendMessageTo", function (reciver) {
            console.log("Send to" + `${reciver}`);
            if(reciver != currentUser) LoadChatData(reciver,false);
        });

        connection.on("ReceiveMessageFrom", function (sender) {
            console.log("Receive from" + `${sender}`);
            FetchNumberMessage();
            if(sender != currentUser) LoadChatData(sender,true);
        });

        document.addEventListener("DOMContentLoaded", function () {
            let searchInput = document.querySelector(".search-input");
            let searchResults = document.querySelector(".search-results");

            if (searchInput) {
                let debounceTimeout;

                searchInput.addEventListener("input", function (event) {
                    clearTimeout(debounceTimeout);
                    let query = searchInput.value.trim();

                    // Chỉ tìm kiếm khi có dấu cách
                    if (query.length > 0 && event.data === " ") {
                        debounceTimeout = setTimeout(() => {
                            performSearch(query);
                        }, 300);
                    } else {
                        searchResults.innerHTML = "";
                        searchResults.classList.add("d-none");
                    }
                });

                // Ẩn dropdown khi click ra ngoài
                document.addEventListener("click", function (event) {
                    if (!searchResults.contains(event.target) && event.target !== searchInput) {
                        searchResults.classList.add("d-none");
                    }
                });
            }

            function performSearch(query) {
                fetch(`/Home/GetResults?query=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(data => {
                        console.log("data: ", data);
                        displayResults(data);
                    })
                    .catch(error => console.error("Search error:", error));
            }

            function displayResults(data) {
                searchResults.innerHTML = "";
                if (data.users.length === 0 && data.groups.length === 0) {
                    searchResults.innerHTML = `<li class="list-group-item">No results found</li>`;
                } else {
                    data.users.forEach(user => {
                        let item = document.createElement("li");
                        item.classList.add("list-group-item", "list-group-item-action", "d-flex", "align-items-center");
                        item.innerHTML = `
                                <img src="${user.avatar}" class="rounded-circle me-2" width="30" height="30" alt="Avatar">
                        <span>${user.name}</span>
                    `;
                        //item.onclick = () => window.location.href = `/User/Profile/${user.id}`;
                        searchResults.appendChild(item);
                    });

                    data.groups.forEach(group => {
                        let item = document.createElement("li");
                        item.classList.add("list-group-item", "list-group-item-action", "d-flex", "align-items-center");
                        item.innerHTML = `
                                <img src="${group.avatar}" class="rounded me-2" width="30" height="30" alt="Group Avatar">
                        <span>${group.name}</span>
                    `;
                        item.onclick = () => window.location.href = `/Group/Details/${group.id}`;
                        searchResults.appendChild(item);
                    });
                }
                searchResults.classList.remove("d-none");
            }
        });


    </script>
</body>
</html>
